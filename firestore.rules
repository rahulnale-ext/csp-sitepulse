rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the signed-in SitePulse OTP user can access their own chat messages.
    // The csp_until_ms claim stops data access after the corresponding SitePulse
    // session expires (even if Firebase refresh tokens are still present).
    function cspSignedIn() {
      return request.auth != null
        && request.auth.token.csp_chat == true
        && request.auth.token.csp_until_ms is int
        && request.time < timestamp.value(request.auth.token.csp_until_ms);
    }
    function wellFormedMessage(msg) {
      return msg.keys().hasAll(['senderId','recipientId','participantIds','body','createdAt','readAt'])
        && msg.keys().hasOnly(['senderId','recipientId','participantIds','body','createdAt','readAt'])
        && msg.senderId is string
        && msg.recipientId is string
        && msg.participantIds is list
        && msg.participantIds.size() == 2
        && msg.participantIds.hasAll([msg.senderId,msg.recipientId])
        && msg.senderId != msg.recipientId
        && msg.body is string
        && msg.body.size() > 0
        && msg.body.size() <= 1500;
    }
    match /sitepulseMessages/{messageId} {
      allow get, list: if cspSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if cspSignedIn()
        && wellFormedMessage(request.resource.data)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId.matches('^[A-Za-z0-9_-]{8,128}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.readAt == null;
      allow update: if cspSignedIn()
        && wellFormedMessage(resource.data)
        && request.auth.uid == resource.data.recipientId
        && resource.data.readAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time;
      allow delete: if false;
    }
    // No access to other Firestore collections from the website by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
